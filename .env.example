# ==============================================================================
# Fess n Curious Backend - Environment Variables
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Authentication (JWT)
JWT_SECRET=fess_super_secret_jwt_key_replace_with_strong_secret_in_prod_2026
JWT_EXPIRES_IN=1d

# Supabase PostgreSQL Database (Prisma)
# Connection pooling URL for queries
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL for migrations & schema push
DIRECT_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Object Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=confess-media

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Meta for Developers / Instagram Graph API
# Create app in https://developers.facebook.com with Instagram Graph API / Basic Display
INSTAGRAM_CLIENT_ID=your-meta-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-meta-instagram-app-secret
INSTAGRAM_CALLBACK_URL=http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Token verifikasi webhook Meta (GET /api/auth/instagram/webhook)
INSTAGRAM_VERIFY_TOKEN=fess_instagram_verify_token_2026
# Opsional — versi Graph API & scope OAuth (default sudah sesuai App Review)
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# URL publik backend — dipakai worker finalize internal (auto-post video Reels).
# Di Vercel otomatis terisi; set manual di VPS/Railway (tanpa trailing slash).
BACKEND_PUBLIC_URL=https://your-backend-domain.example.com

# Email (Resend SDK) - OTP verifikasi email & reset kata sandi
# Untuk production, EMAIL_FROM wajib memakai domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Fess n Curious <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Payments (Midtrans Core API) & base payouts
# ------------------------------------------------------------------------------
# Kill switches must stay false until sign-off.
PAYMENTS_ENABLED=false
BASE_PAYOUTS_ENABLED=false
# One-time welcome bonus for newly verified users. Set 0 to disable.
WELCOME_CTF_BONUS=1
BASE_PAYOUT_FEE_IDR=6500
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
# Shared secret for the internal reconciliation endpoint.
PAYMENT_RECONCILE_SECRET=replace_with_a_long_random_secret
