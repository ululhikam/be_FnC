# ==============================================================================
# Fess n Curious — DEV ENVIRONMENT TEMPLATE
# Copy ke `.env.development` lalu isi. File `.env.development` TIDAK di-commit.
# Jangan pernah memakai database production di sini.
# ==============================================================================

PORT=3000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://fessncurious-dev.vercel.app

# JWT khusus dev — jangan sama dengan production.
JWT_SECRET=ganti-dengan-secret-dev-yang-panjang-dan-acak
JWT_EXPIRES_IN=1d

# Supabase project DEV (diisi setelah project dibuat).
# Pooler untuk query runtime:
DATABASE_URL=postgresql://postgres.<DEV_PROJECT_REF>:<DEV_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Session pooler untuk migrasi. Pakai host pooler (bukan db.<ref>.supabase.co)
# agar tetap jalan di jaringan yang tidak punya IPv6.
DIRECT_URL=postgresql://postgres.<DEV_PROJECT_REF>:<DEV_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_URL=https://<DEV_PROJECT_REF>.supabase.co
SUPABASE_KEY=<DEV_SERVICE_ROLE_KEY>
SUPABASE_BUCKET=confess-media-dev

# OAuth dev. Redirect URI harus didaftarkan di Google/Meta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_VERIFY_TOKEN=ganti-token-verify-dev
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

BACKEND_PUBLIC_URL=http://localhost:3000

# Email dev. Bisa memakai Resend key terpisah atau key yang sama dengan
# pengaturan domain pengirim yang aman untuk dev.
RESEND_API_KEY=
EMAIL_FROM=Fess n Curious Dev <onboarding@resend.dev>

# Payment flags — default mati sampai backend & webhook siap.
PAYMENTS_ENABLED=false
BASE_PAYOUTS_ENABLED=false
BASE_PAYOUT_FEE_IDR=6500
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
PAYMENT_RECONCILE_SECRET=ganti-dengan-secret-rekonsiliasi-dev
