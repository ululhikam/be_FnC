{
  "version": 2,
  "regions": ["syd1"],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/**",
          "prisma/**",
          "fonts/**",
          "assets/**",
          "public/**",
          "scripts/measure-templates.mjs",
          "scripts/template-meta.mjs"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
